{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nsf/featured-resources",
	"title": "Featured Resources",
	"category": "widgets",
	"icon": "star-filled",
	"description": "Three picked resources, posts or pages as featured image cards. Until all three are picked, the newest resources fill the gaps.",
	"keywords": [ "featured", "resources", "cards" ],
	"textdomain": "nsf",
	"attributes": {
		"items": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": [ "top", "bottom" ]
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
