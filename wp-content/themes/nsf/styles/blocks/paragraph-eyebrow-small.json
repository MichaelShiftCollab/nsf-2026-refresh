{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Eyebrow, small",
	"slug": "eyebrow-small",
	"blockTypes": [
		"core/paragraph"
	],
	"styles": {
		"color": {
			"text": "var(--wp--preset--color--primary-orange)"
		},
		"typography": {
			"fontSize": "var(--wp--preset--font-size--x-small)",
			"lineHeight": "1.4286",
			"fontWeight": "700",
			"letterSpacing": "var(--wp--custom--letter-spacing--caps)",
			"textTransform": "uppercase"
		}
	}
}
